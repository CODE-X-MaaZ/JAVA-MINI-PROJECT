# Environment variable template — safe to commit, contains no secrets
#
# Copy this file to .env and fill in your local values:
#   cp .env.example .env   (Linux/macOS)
#   Copy-Item .env.example .env   (PowerShell)
#
# The .env file is excluded by .gitignore — never commit it.

# Backend API base URL (default: local Spring Boot on port 8080)
VITE_API_BASE_URL=http://localhost:8080/api
